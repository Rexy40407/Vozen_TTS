[Unit]
Description=Vozen runtime on manually unlocked encrypted storage
Requires=docker.service
After=docker.service srv-vozen\x2dsecure.mount
ConditionPathExists=/dev/mapper/vozen-data
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
ExecStartPre=/usr/local/sbin/vozen-data-guard
ExecStart=/usr/bin/docker start --attach vozen-rust-prod-vozen-1
ExecStop=/usr/bin/docker stop --time 60 vozen-rust-prod-vozen-1
Restart=always
RestartSec=10
TimeoutStopSec=75
StandardOutput=null
StandardError=journal

[Install]
WantedBy=multi-user.target
