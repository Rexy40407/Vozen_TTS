# Copy this file to .env.rust.staging and keep the copy untracked.
# Use a second Discord application/token and a disposable test guild only.

DISCORD_TOKEN=
CLIENT_ID=
DB_PATH=./.staging/tts.db
MODELS_DIR=./models
TTS_ENGINE=piper
SINGLE_INSTANCE_PORT=59595

# Start in shadow mode. Promote individual canaries only after the preflight passes.
RUST_RUNTIME_MODE=shadow
RUST_RUNTIME_READY=false
RUST_REGISTER_COMMANDS_ENABLED=true
RUST_AUTOCOMPLETE_ENABLED=true
RUST_COMMANDS_GUILD_ID=
OWNER_GUILD_ID=
RUST_COMMANDS_STATE_PATH=./.staging/commands-state-rust.json

# Keep HTTP and ownership surfaces disabled during the Discord gateway smoke test.
RUST_BROWSER_API_ENABLED=false
PREMIUM_API_ENABLED=false
RUST_DASHBOARD_ENABLED=false
RUST_ADMIN_API_ENABLED=false
RUST_OWNER_COMMANDS_ENABLED=false

# Voice canary: enable only after command registration/preflight is green.
RUST_CORE_VOICE_ENABLED=false
RUST_QUEUE_ENABLED=false
RUST_MESSAGE_AUTOREAD_ENABLED=false
RUST_RANDOMIZER_ENABLED=false
RUST_CAST_ENABLED=false
RUST_SETUP_ENABLED=false

# Optional loopback health probe.
HEALTH_PORT=
